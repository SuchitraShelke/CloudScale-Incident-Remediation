# Copy to .env. Defaults work for `LLM_MODE=scripted` (no API key needed).
LLM_MODE=scripted
ANTHROPIC_API_KEY=
MODEL_DEEP=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5

POSTGRES_PASSWORD=cloudscale
GUARD_MODEL=llama-guard3:1b

# M3: identity + audit. Change these outside a local demo.
SESSION_SECRET=dev-session-secret-change-me-32-bytes-min
DEMO_USERS=viewer:viewer:viewer,sre1:sre1:sre,sre2:sre2:sre,lead1:lead1:senior_sre
AUDIT_DB_PASSWORD=audit-writer-dev
